                <mxCell id="s-notification-stock" parent="s1" style="shape=mxgraph.uml.class;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=12;fillColor=#FFFFFF;strokeColor=#667085;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:center;font-size:15px;font-weight:bold&quot;&gt;MedicalInventoryLowStockNotification&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ inventory: MedicalInventory&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ __construct(inventory: MedicalInventory)&lt;/div&gt;&lt;div&gt;+ via(notifiable: object): array&lt;/div&gt;&lt;div&gt;+ toArray(notifiable: object): array&lt;/div&gt;" vertex="1">
                    <mxGeometry height="250" width="620" x="1460" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="s-notification-event-management" parent="s1" style="shape=mxgraph.uml.class;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=12;fillColor=#FFFFFF;strokeColor=#667085;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:center;font-size:15px;font-weight:bold&quot;&gt;EventManagementNotification&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ event: Event&lt;/div&gt;&lt;div&gt;+ type: string&lt;/div&gt;&lt;div&gt;+ title: string&lt;/div&gt;&lt;div&gt;+ message: string&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ __construct(event: Event, type: string, title: string, message: string)&lt;/div&gt;&lt;div&gt;+ via(notifiable: object): array&lt;/div&gt;&lt;div&gt;+ toArray(notifiable: object): array&lt;/div&gt;&lt;div&gt;- formatTime(time: ?string): ?string&lt;/div&gt;" vertex="1">
                    <mxGeometry height="350" width="620" x="1460" y="1040" as="geometry"/>
                </mxCell>
                <mxCell id="s-notification-announcement" parent="s1" style="shape=mxgraph.uml.class;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=12;fillColor=#FFFFFF;strokeColor=#667085;strokeWidth=1.5;" value="&lt;div style=&quot;text-align:center;font-size:15px;font-weight:bold&quot;&gt;AnnouncementPublishedNotification&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ announcement: Announcement&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;+ __construct(announcement: Announcement)&lt;/div&gt;&lt;div&gt;+ via(notifiable: object): array&lt;/div&gt;&lt;div&gt;+ toArray(notifiable: object): array&lt;/div&gt;" vertex="1">
                    <mxGeometry height="250" width="620" x="1460" y="1410" as="geometry"/>
                </mxCell>
                <mxCell id="s-legend" parent="s1" style="shape=note;whiteSpace=wrap;html=1;size=15;boundedLbl=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F2F4F7;strokeColor=#667085;" value="&lt;b&gt;Scope and integration notes&lt;/b&gt;&lt;br&gt;Dashed arrows are command/service dependencies. EventReminderService, MedicalInventoryExpiryService, and MedicalInventoryLowStockService read Event / MedicalInventory and User records and persist database notifications through the notification classes shown. AuditLogService writes AuditLog; SystemSettingService reads/writes SystemSetting; BackupService invokes mysqldump; UniSmsService calls the external UniSMS API. AnnouncementPublishedNotification and EventManagementNotification are dispatched by their controllers. All five application notifications extend Laravel Notification; the three commands extend Laravel Command. HTTP controllers and route middleware were inspected but excluded as HTTP adapters rather than domain state; framework base classes and third-party APIs are not expanded. No application interfaces were found." vertex="1">
                    <mxGeometry height="240" width="1320" x="60" y="1330" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
