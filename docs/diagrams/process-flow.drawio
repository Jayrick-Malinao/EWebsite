    <diagram id="automation-reporting" name="4 - Automation and Reporting">
        <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4-title" value="SCHEDULED NOTIFICATIONS, REPORTS AND ADMINISTRATION" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="400" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4-scheduler" value="Laravel scheduler&#xa;Asia/Manila; withoutOverlapping" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
