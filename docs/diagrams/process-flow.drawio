                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-e11" value="Stock recovered" edge="1" parent="1" source="p4-stock-check" target="p4-stock-reset" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
