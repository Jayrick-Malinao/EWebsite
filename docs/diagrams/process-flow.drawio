                <mxCell id="p4-e6" value="Yes" edge="1" parent="1" source="p4-event-check" target="p4-event-yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-e7" edge="1" parent="1" source="p4-expiry" target="p4-expiry-check" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-e8" value="Eligible" edge="1" parent="1" source="p4-expiry-check" target="p4-expiry-yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
