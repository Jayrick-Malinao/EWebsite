    <diagram id="records-workflows" name="2 - Records and Services">
        <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2-title" value="STAFF RECORDS AND SERVICE WORKFLOWS" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="430" y="20" width="640" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2-start" value="Authorized staff&#xa;Admin / Official / Health Worker" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="620" y="90" width="260" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2-module" value="Select an authorized module&#xa;Resident / Household / Health program / Inventory / Certificate / Schedule" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="575" y="195" width="350" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2-entry" value="Enter or edit form data&#xa;Common name and mobile normalization runs on requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="620" y="350" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p2-validate" value="Validate required fields, formats, ranges, relationships and business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="620" y="465" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p2-valid" value="Input valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="665" y="580" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p2-errors" value="Return form errors&#xa;Keep input; correct and resubmit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="1030" y="595" width="230" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2-save" value="Create / update / delete record&#xa;Household create/update uses a database transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="620" y="720" width="270" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p2-out" value="Show updated list/detail or confirmation&#xa;Database is shared by staff dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="620" y="840" width="270" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2-residents" value="RESIDENTS + HOUSEHOLDS&#xa;Resident: identity, DOB, gender, contacts, Purok, status, household relationship&#xa;Household: unique code, address, head, contact, members&#xa;Decision: head creates/links household; member must join household with head&#xa;Tables: residents ↔ households" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="130" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p2-health" value="HEALTH PROGRAM RECORDS&#xa;Immunization: vaccine, dose and dates&#xa;Maternal care: pregnancy, prenatal and delivery details&#xa;Child health: growth, nutrition, vitamin A and deworming&#xa;Senior citizen: OSCA, health, caregiver and benefits&#xa;Each record links to a resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="365" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p2-health-gap" value="SCHEMA LIMITATION&#xa;HealthRecordController/Model and HealthVisitController/Model exist, but migrations drop health_visits and do not create health_records. These two workflows cannot be confirmed on a clean migrated database." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="590" width="430" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="p2-inventory" value="MEDICAL INVENTORY&#xa;Medicine name, expiry date, quantity&#xa;Quantity must be a nonnegative integer; create rejects past expiry dates&#xa;Tables: medical_inventories&#xa;Role: System Administrator / Health Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="1030" y="130" width="430" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="p2-cert" value="CERTIFICATES&#xa;Select resident/type, issue date, purpose, remarks&#xa;Generate number; set issuer and Issued status&#xa;Print supported; cancel changes status (not hard delete)&#xa;Tables: certificates, residents, users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="1030" y="320" width="430" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="p2-schedule" value="SCHEDULE / EVENTS&#xa;Title/type/date; optional time, location, description&#xa;Date cannot be past; end time must follow start time&#xa;Create/update/cancel sends in-app notices to staff&#xa;Table: events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="1030" y="520" width="430" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="p2-note" value="No approval step was found for resident, health, inventory, certificate, or event operations. Validation errors are surfaced to the form; unexpected DB errors use Laravel exception handling." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="735" width="460" height="90" as="geometry"/>
                </mxCell>
