                    <mxGeometry x="90" y="230" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4-event-check" value="Event today/tomorrow?&#xa;reminder_sent=false; start time exists; event is still future" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="380" y="220" width="260" height="100" as="geometry"/>
