                <mxCell id="p3-title" value="ANNOUNCEMENT TARGETING, IN-APP NOTICE AND MANUAL UNISMS FLOW" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="280" y="20" width="840" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3-staff" value="Authorized staff creates&#xa;announcement" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="590" y="95" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p3-form" value="Enter title, message, priority, target&#xa;Optional age range / specific resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="560" y="190" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-validate" value="Validate target, priority, required text, age bounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="560" y="295" width="280" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3-preview" value="Preview eligible active residents&#xa;Group SMS count by household/head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="560" y="395" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-match" value="Any residents match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="615" y="505" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3-empty" value="No: return error&#xa;Choose a target and retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="960" y="520" width="220" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3-publish" value="Publish in DB transaction&#xa;Create announcement + recipient rows&#xa;Prepare one pending SMS delivery per household head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="520" y="650" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p3-inapp" value="Create database in-app notification&#xa;for System Administrator, Official, Health Worker&#xa;Announcement is published immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="520" y="790" width="360" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p3-manual" value="Staff manually requests&#xa;send pending SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="560" y="925" width="280" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3-enabled" value="UNISMS_SMS_ENABLED&#xa;and key + sender ID configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="615" y="1030" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3-disabled" value="No: show disabled / missing-config error&#xa;Do not call provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="960" y="1045" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-pending" value="Load Pending deliveries&#xa;No pending: show informational message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="560" y="1175" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-number" value="Household head&#xa;contact number present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="615" y="1285" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3-failed" value="No: mark delivery Failed&#xa;Store missing-number reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="960" y="1295" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3-provider" value="UniSmsService validates Philippine number&#xa;HTTPS POST JSON to UniSMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="560" y="1420" width="280" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p3-result" value="Provider confirms acceptance?&#xa;HTTP 201 + pending status + reference ID" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="615" y="1530" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3-sent" value="Yes: mark Sent&#xa;Store sent_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="240" y="1545" width="190" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3-uncertain" value="No / uncertain: mark Failed&#xa;Store sanitized reason; report result&#xa;No automatic retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="960" y="1540" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="p3-targets" value="Target choices: specific resident, senior (age ≥60 or active senior record), children (default ages 0–5), pregnant (Pregnant and no actual delivery date), general, or age bracket. Only active residents are selected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="60" y="240" width="390" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="p3-notice" value="SMS is opt-in by configuration and manually triggered. In-app notifications are database notifications; neither this path nor the scheduled notifications imply SMS delivery." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="70" y="470" width="390" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e1" edge="1" parent="1" source="p3-staff" target="p3-form" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;">
