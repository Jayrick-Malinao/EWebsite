                </mxCell>
                <mxCell id="p4-event-yes" value="Yes: database reminder notifications&#xa;to System Administrator, Official, Health Worker&#xa;Set reminder_sent=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="680" y="215" width="360" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="p4-expiry" value="Daily 08:00&#xa;Inventory expiry command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="90" y="500" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4-expiry-check" value="Expiry window?&#xa;30 / 15 / 7 days, today, or expired" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="380" y="485" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-expiry-yes" value="Check for duplicate database notice&#xa;Notify active System Administrators + Health Workers&#xa;Update alert flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="680" y="475" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-stock" value="Every 30 minutes&#xa;Low-stock command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="90" y="760" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4-stock-check" value="Quantity ≤ 10 and alert not sent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="380" y="745" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-stock-yes" value="Yes: lock inventory row; create database notices for active Admin/Health Worker; set flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="680" y="730" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p4-stock-reset" value="Quantity &gt; 10: reset flag&#xa;Future low-stock alert may be sent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="745" width="300" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p4-inbox" value="Staff notification inbox&#xa;List / unread count / mark one or all read&#xa;Only owning user may mark individual notice read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="420" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-staff" value="Authenticated staff&#xa;Admin for admin-only tools" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="90" width="250" height="65" as="geometry"/>
                </mxCell>
