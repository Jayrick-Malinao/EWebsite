                <mxCell id="note20" value="Controllers: SystemSettingController@index, update; SystemSettingService@all, setMany, set, clearCache; AuditLogService::log&#xa;Models/services: SystemSetting; AuditLog&#xa;Tables/integrations: system_settings; audit_logs&#xa;setMany writes rows one-by-one and does not wrap them in a transaction.&#xa;event_reminders_enabled and event_reminder_days are stored settings, but EventReminderService does not read them; actual scheduling remains daily at 08:00 and checks today/tomorrow." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1">
